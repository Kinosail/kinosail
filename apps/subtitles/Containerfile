FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
WORKDIR /src
COPY packages/go.mod ./packages/go.mod
COPY apps/subtitles/go.mod apps/subtitles/go.sum ./apps/subtitles/
RUN cd apps/subtitles && go mod download
COPY packages ./packages
COPY apps/subtitles/cmd ./apps/subtitles/cmd
COPY apps/subtitles/internal ./apps/subtitles/internal
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN cd apps/subtitles && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /kinosail ./cmd/kinosail

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f AS whisper
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates cmake g++ make wget \
    && wget -q -O /tmp/whisper.tar.gz https://codeload.github.com/ggml-org/whisper.cpp/tar.gz/refs/tags/v1.9.5 \
    && echo "ff1a9053feb509ff9d7729703355541ae9690073a6b1c40eb692c962e0dc1720  /tmp/whisper.tar.gz" | sha256sum -c - \
    && mkdir /whisper && tar -xzf /tmp/whisper.tar.gz -C /whisper --strip-components=1 \
    && cmake -S /whisper -B /whisper/build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DGGML_NATIVE=OFF -DGGML_OPENMP=OFF -DWHISPER_BUILD_TESTS=OFF \
    && cmake --build /whisper/build --target whisper-cli -j2 \
    && sed -n '/This software is available/,$p' /whisper/examples/miniaudio.h > /whisper/miniaudio-LICENSE \
    && sed -n '/This software is available/,$p' /whisper/examples/stb_vorbis.c > /whisper/stb_vorbis-LICENSE

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
ARG JELLYFIN_FFMPEG_VERSION=8.1.3-1
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates libaom3 libarchive-tools libchromaprint-tools mesa-va-drivers mesa-vulkan-drivers socat tzdata wget libstdc++6 tesseract-ocr tesseract-ocr-eng \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libaom3)" ge 3.12.1-1+deb13u1 \
    && for package in libssl3t64 openssl openssl-provider-legacy; do dpkg --compare-versions "$(dpkg-query -W -f='${Version}' "$package")" ge '3.5.7-1~deb13u3' || exit 1; done \
    && arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
      amd64) checksum=fbef9f81a53e175194e3f67832618a86111f7bd37197df21a5d748c34289f9c0; apt-get install -y --no-install-recommends i965-va-driver intel-media-va-driver ;; \
      arm64) checksum=4af743bd776eda082d40c851a4201e51a77a258145dd6ebe164dade39b35b2d0 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
    && wget -q -O /tmp/jellyfin-ffmpeg.deb "https://github.com/jellyfin/jellyfin-ffmpeg/releases/download/v${JELLYFIN_FFMPEG_VERSION}/jellyfin-ffmpeg8_${JELLYFIN_FFMPEG_VERSION}-trixie_${arch}.deb" \
    && echo "$checksum  /tmp/jellyfin-ffmpeg.deb" | sha256sum -c - \
    && apt-get install -y --no-install-recommends /tmp/jellyfin-ffmpeg.deb \
    && apt-get purge -y --auto-remove wget \
    && ln -s /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/local/bin/ffmpeg \
    && ln -s /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe \
    && groupadd -g 10001 kinosail \
    && useradd -M -u 10001 -g kinosail -s /usr/sbin/nologin kinosail \
	&& mkdir -p /config /cache /media /backups /public-transport \
	&& chown -R kinosail:kinosail /config /cache /backups /public-transport \
    && rm -f /tmp/jellyfin-ffmpeg.deb \
    && rm -rf /var/lib/apt/lists/*
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.version=$VERSION org.opencontainers.image.revision=$REVISION
COPY --from=build /kinosail /usr/local/bin/kinosail
COPY --from=whisper /whisper/build/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=whisper /whisper/LICENSE /licenses/third_party/whisper.cpp/LICENSE
COPY --from=whisper /whisper/miniaudio-LICENSE /whisper/stb_vorbis-LICENSE /licenses/third_party/whisper.cpp/
COPY apps/subtitles/LICENSE apps/subtitles/LICENSING.md apps/subtitles/THIRD_PARTY_NOTICES.md /licenses/
COPY apps/subtitles/third_party /licenses/third_party
COPY packages/webassets/static/fonts/OFL-Manrope.txt /licenses/third_party/Manrope.LICENSE
COPY packages/third_party /licenses/third_party
USER kinosail
ENV KINOSAIL_LISTEN=:38128
VOLUME ["/config", "/cache", "/backups"]
EXPOSE 38128
HEALTHCHECK CMD kinosail healthcheck
ENTRYPOINT ["kinosail"]
