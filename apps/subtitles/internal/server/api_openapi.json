    "/api/v1/home-assistant/players/{id}/commands": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "commandHomeAssistantPlayer", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/events": {"get": {"operationId": "streamEvents", "description": "Streams profile-scoped invalidation events. Resume with Last-Event-ID.", "parameters": [{"name": "Last-Event-ID", "in": "header", "schema": {"type": "string", "pattern": "^[0-9]{1,20}$"}}], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/library": {"get": {"operationId": "listLibrary", "parameters": [{"name": "q", "in": "query", "schema": {"type": "string", "maxLength": 512}}, {"name": "view", "in": "query", "schema": {"type": "string", "enum": ["all", "list", "unwatched", "history", "movies", "shows", "collections", "playlists", "music", "audiobooks", "books", "photos"]}}, {"name": "sort", "in": "query", "schema": {"type": "string", "enum": ["title", "added", "year"]}}, {"name": "letter", "in": "query", "description": "Jump to an available title bucket. Valid only with title sort and without q or offset; available labels and counts are returned in letters.", "schema": {"type": "string", "maxLength": 1}}, {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0, "maximum": 1000000, "default": 0}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 100}}], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/subtitle-library/{id}/draft": {"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"operationId":"getLocalSubtitleDraft","description":"Read the current local draft, recognition confidence, and estimated word timing.","parameters":[{"name":"language","in":"query","schema":{"type":"string"}}],"responses":{"default":{"$ref":"#/components/responses/Result"}}},"post":{"operationId":"generateLocalSubtitleDraft","description":"Start or cancel local bitmap OCR or Whisper transcription. One bounded job and one volatile draft are retained; nothing is installed automatically.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["language","method","action"],"properties":{"language":{"type":"string"},"method":{"enum":["ocr","transcription"]},"action":{"enum":["start","cancel"]},"draftId":{"type":"string","pattern":"^[a-f0-9]{64}$","description":"Required only for cancellation."}}}}}},"responses":{"default":{"$ref":"#/components/responses/Result"}}}},
    "/api/v1/subtitle-library/{id}/inspect": {"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"operationId":"inspectSubtitle","parameters":[{"name":"language","in":"query","schema":{"type":"string","minLength":2,"maxLength":64}}],"responses":{"default":{"$ref":"#/components/responses/Result"}}}},
    "/api/v1/subtitle-library/{id}/export": {"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"operationId":"exportSubtitle","parameters":[{"name":"language","in":"query","schema":{"type":"string","minLength":2,"maxLength":64}},{"name":"format","in":"query","schema":{"type":"string","enum":["srt","vtt","original"],"default":"srt"}}],"responses":{"200":{"description":"Subtitle download; same-format WebVTT and original preserve source bytes."},"default":{"$ref":"#/components/responses/Result"}}}},
    "/api/v1/subtitle-library/{id}/preview": {"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"previewSubtitleEdit","description":"Preview conversion and timing without changing the sidecar.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SubtitleEdit"}}}},"responses":{"default":{"$ref":"#/components/responses/Result"}}}},
    "/api/v1/subtitle-library/{id}/apply": {"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"applySubtitleEdit","description":"Save a reviewed subtitle using a required current fingerprint, original archive, recovery copy, and automatic-upgrade protection.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SubtitleEdit"}}}},"responses":{"default":{"$ref":"#/components/responses/Result"}}}},
    "/api/v1/subtitle-library/{id}/audio": {"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"analyzeSubtitleAudio","description":"Analyze main dialogue locally; return bounded waveform and speech probability bins.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"language":{"type":"string","minLength":2,"maxLength":64}}}}}},"responses":{"default":{"$ref":"#/components/responses/Result"}}}},
    "/api/v1/subtitle-library": {"get": {"operationId": "getSubtitleLibrary", "parameters": [{"name": "q", "in": "query", "schema": {"type": "string", "maxLength": 128}}, {"name": "view", "in": "query", "schema": {"type": "string", "enum": ["summary", "wanted", "library"]}}, {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 1}, "description": "Canonical decimal page number. Overview accepts only page 1. Pages beyond the current last page are clamped."}, {"name": "kind", "in": "query", "schema": {"type": "string", "enum": ["all", "movie", "episode"], "default": "all"}}, {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["all", "ready", "wanted", "checking", "unavailable"], "default": "all"}, "description": "Library status filter. Overview accepts only all; Wanted accepts all or wanted."}, {"name": "sort", "in": "query", "schema": {"type": "string", "enum": ["title", "modified"], "default": "title"}}], "responses": {"default": {"$ref": "#/components/responses/Result"}}, "description": "Paginated subtitle inventory. Overview returns up to 6 wanted files; Library and Wanted return up to 40. Counts cover the visible library. matched, page, pages, pageSize, start, end, previousURL and nextURL describe the filtered page. Readiness and provider health are included on Overview. Track facts are read from memory while background checks warm the cache."}},
    "/api/v1/subtitle-library/{id}/fetch": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "fetchSubtitleSidecar", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"language": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,4})?$"}}}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/subtitle-library/{id}/replacement": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "setSubtitleReplacementPolicy", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["replaceable"], "properties": {"replaceable": {"type": "boolean"}}}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/subtitle-library/{id}/restore": {"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"restorePreviousSubtitle","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"language":{"type":"string","minLength":2,"maxLength":64}}}}}},"responses":{"default":{"$ref":"#/components/responses/Result"}}}},
    "/api/v1/subtitle-library/fetch-wanted": {"post": {"operationId": "fetchWantedSubtitleSidecars", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"language": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,4})?$"}, "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10}}}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/subtitle-library/maintain": {"post": {"operationId": "maintainSubtitleSidecars", "description": "Adds missing subtitles and upgrades managed or exact-hash sidecars when a better trusted match is available.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"language": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,4})?$"}, "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10}}}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/subtitle-providers/test": {"post": {"operationId": "testSubtitleProviders", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
