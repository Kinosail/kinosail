{
  "name": "@kinosail/player-client",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "open Kinosail.xcodeproj",
    "ios": "./scripts/build-apple.sh ios",
    "web": "expo start --web",
    "lint": "../../../../scripts/tooling/gate-shell.sh -c 'expo lint'",
    "format:check": "../../../../scripts/tooling/gate-shell.sh -c 'prettier --check .'",
    "test": "../../../../scripts/tooling/gate-shell.sh -c 'jest --runInBand'",
    "test:coverage": "../../../../scripts/tooling/gate-shell.sh -c 'jest --runInBand --coverage --coverageReporters=text-summary'",
    "test:mutation": "../../../../scripts/tooling/gate-shell.sh -c 'stryker run'",
    "test:watch": "../../../../scripts/tooling/gate-shell.sh -c 'jest --watch'",
    "typecheck": "../../../../scripts/tooling/gate-shell.sh -c 'tsc --noEmit'",
    "verify": "../../../../scripts/tooling/gate-shell.sh -c 'pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm test:mutation'",
    "prebuild": "expo prebuild --platform ios --clean",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --platform ios --clean",
    "export:web": "expo export --platform web",
    "tvos": "./scripts/build-apple.sh tvos"
  },
  "dependencies": {
    "expo": "~57.0.20",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.3",
    "js-base64": "^3.9.3",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "npm:react-native-tvos@0.86.2-0",
    "react-native-google-cast": "4.9.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@react-native/jest-preset": "0.86.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "26.4.1",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest-expo": "^57.0.5",
    "jscpd": "5.1.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "<rootDir>/.stryker-tmp/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.stryker-tmp/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/testing/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/testing/jest-setup.ts"
    ],
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "expo/internal/babel-preset"
          ],
          "plugins": [
            "@babel/plugin-transform-dynamic-import"
          ],
          "caller": {
            "name": "metro",
            "bundler": "metro",
            "platform": "ios"
          }
        }
      ]
    }
  },
  "private": true
}
