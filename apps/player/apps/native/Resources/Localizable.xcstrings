    "TMDB": {
      "localizations": {}
    },
    "This product uses the TMDB API but is not endorsed or certified by TMDB.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم هذا المنتج واجهة برمجة تطبيقات TMDB ولكنه غير معتمد أو معتمد من TMDB."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този продукт използва API на TMDB, но не се одобрява и не е сертифициран от TMDB."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পণ্যটি TMDB API ব্যবহার করে, তবে TMDB এটি অনুমোদন বা প্রত্যয়ন করেনি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest producte fa servir l'API de TMDB, però TMDB no el recomana ni el certifica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento produkt používá TMDB API, ale TMDB ho neschvaluje ani necertifikuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette produkt bruger TMDB API'et, men er ikke godkendt eller certificeret af TMDB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Produkt verwendet die TMDB-API, ist jedoch nicht von TMDB unterstützt oder zertifiziert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το προϊόν χρησιμοποιεί το API του TMDB, αλλά δεν εγκρίνεται ούτε πιστοποιείται από το TMDB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este producto usa la API de TMDB, pero no está respaldado ni certificado por TMDB."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این محصول از API مربوط به TMDB استفاده می‌کند، اما TMDB آن را تأیید یا گواهی نکرده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tuote käyttää TMDB API -rajapintaa, mutta TMDB ei ole hyväksynyt tai sertifioinut sitä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagamit ang produktong ito ng TMDB API pero hindi ito in-endorso o na-certify ng TMDB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce produit utilise l'API TMDB mais n'est ni approuvé ni certifié par TMDB."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצר זה משתמש ב-API של TMDB, אך אינו מאושר או מוסמך על ידי TMDB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उत्पाद TMDB API का उपयोग करता है, लेकिन TMDB द्वारा इसका समर्थन या प्रमाणन नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj proizvod koristi TMDB API, ali ga TMDB nije odobrio niti certificirao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a termék a TMDB API-t használja, de a TMDB nem támogatja és nem hagyta jóvá."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Produk ini memakai API TMDB, tetapi tidak didukung atau disertifikasi oleh TMDB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo prodotto utilizza l'API TMDB ma non è approvato o certificato da TMDB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この製品は TMDB API を使用していますが、TMDB によって承認または認定されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
