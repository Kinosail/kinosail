# Use an absolute directory containing your media.
KINOSAIL_MEDIA_PATH=/path/to/media
KINOSAIL_BIND=127.0.0.1
KINOSAIL_PORT=38127
# Release installer only: keep the default project name to reconnect persistent volumes across installer directories.
KINOSAIL_PROJECT_NAME=kinosail
KINOSAIL_IMAGE=ghcr.io/mikeo7/kinosail-player
KINOSAIL_VERSION=latest
KINOSAIL_SCAN_INTERVAL=
KINOSAIL_SCAN_FREQUENCY=
KINOSAIL_SERVER_NAME=
KINOSAIL_REQUIRE_MFA=
KINOSAIL_LIBRARIES=
KINOSAIL_PLAYBACK_MODE=
KINOSAIL_AUTOPLAY=
KINOSAIL_SUBTITLES=
KINOSAIL_AUTO_SKIP=
KINOSAIL_TRANSCODE_QUALITY=
KINOSAIL_TRANSCODE_CODEC=
KINOSAIL_TRANSCODE_ACCELERATOR=
KINOSAIL_TONE_MAP=
KINOSAIL_SUBTITLE_LANGUAGE=
KINOSAIL_JELLYFIN_ENABLED=
KINOSAIL_HOME_ASSISTANT_ENABLED=
KINOSAIL_DLNA_URL=
KINOSAIL_DLNA_ENABLED=
KINOSAIL_CONFIG_FILE=
KINOSAIL_MEDIA_DIR=
KINOSAIL_DATA_DIR=
KINOSAIL_CACHE_DIR=
KINOSAIL_FFMPEG=
KINOSAIL_FFPROBE=
KINOSAIL_FPCALC=
# TLS 1.2/1.3 with forward-secret AEAD ciphers is on by default. Set false only when a trusted local TLS terminator protects every connection.
KINOSAIL_TLS_ENABLED=
# JSON array of LAN DNS names/IPs accepted as aliases and included in Kinosail's generated certificate. Do not include ports.
KINOSAIL_TLS_HOSTS=
# Optional canonical HTTPS origin and passkey origin, for example https://media.example.com:38127.
KINOSAIL_AUTH_URL=
KINOSAIL_BACKUP_DIR=
# Required for automatic backups. The installer generates a 256-bit file secret.
KINOSAIL_BACKUP_KEY=
KINOSAIL_BACKUP_KEY_FILE=/run/secrets/kinosail_backup_key
KINOSAIL_BACKUP_KEY_PATH=./secrets/backup_key
KINOSAIL_BACKUP_INTERVAL=
KINOSAIL_BACKUP_RETENTION=
KINOSAIL_LOG_LEVEL=
KINOSAIL_AUDIT_RETENTION=
KINOSAIL_PLAYBACK_RETENTION=
# Use a host/NAS path here for off-host-friendly backups; blank uses the named volume.
KINOSAIL_BACKUP_PATH=kinosail-backups
# The release installer detects supported GPUs. Use off to force software transcoding.
KINOSAIL_GPU_BACKEND=auto
# Advanced override: use backend=device with a canonical /dev mapping or NVIDIA CDI device.
KINOSAIL_GPU_DEVICE=

KINOSAIL_PROXY_TOKEN=
KINOSAIL_PROXY_TOKEN_FILE=
# Secure remote access: off or https.
KINOSAIL_REMOTE_MODE=off
KINOSAIL_DUCKDNS_DOMAIN=
KINOSAIL_DUCKDNS_TOKEN=
KINOSAIL_DUCKDNS_TOKEN_FILE=
KINOSAIL_DUCKDNS_TOKEN_PATH=./secrets/duckdns_token
KINOSAIL_REMOTE_LISTEN=
KINOSAIL_REMOTE_BIND=0.0.0.0
KINOSAIL_WEBHOOK_URL=
KINOSAIL_WEBHOOK_TOKEN=
KINOSAIL_WEBHOOK_TOKEN_FILE=
# Register https://your-kinosail-address/login/oidc/callback with the provider.
KINOSAIL_OIDC_ISSUER=
KINOSAIL_OIDC_CLIENT_ID=
KINOSAIL_OIDC_CLIENT_SECRET=
KINOSAIL_OIDC_CLIENT_SECRET_FILE=
KINOSAIL_OIDC_REDIRECT_URL=
KINOSAIL_OIDC_IDENTITY_CLAIM=sub
KINOSAIL_SAML_METADATA_URL=
KINOSAIL_SAML_METADATA_XML=
KINOSAIL_SAML_IDENTITY_ATTRIBUTE=NameID
KINOSAIL_SCIM_TOKEN=
KINOSAIL_SCIM_TOKEN_FILE=
KINOSAIL_SCIM_TOKEN_EXPIRES_AT=
# Optional modern MCP 2026-07-28 endpoint with an external OAuth 2.1 authorization server.
KINOSAIL_MCP_RESOURCE_URL=
KINOSAIL_MCP_AUTHORIZATION_SERVER=
KINOSAIL_MCP_INTROSPECTION_URL=
KINOSAIL_MCP_CLIENT_ID=
KINOSAIL_MCP_CLIENT_SECRET=
KINOSAIL_MCP_CLIENT_SECRET_FILE=

# Optional TMDB metadata. Commercial products require a TMDB commercial license.
KINOSAIL_TMDB_URL=
KINOSAIL_TMDB_IMAGE_URL=
KINOSAIL_TMDB_TOKEN=
KINOSAIL_TMDB_TOKEN_FILE=
