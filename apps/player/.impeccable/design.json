      "html": "<label class=\"ds-progress\">Watch progress<progress value=\"0.35\" max=\"1\"></progress></label>",
      "css": ".ds-progress{display:grid;gap:.5rem;font-family:var(--font-ui,Manrope,sans-serif);font-size:.875rem;font-variant-numeric:tabular-nums;color:var(--muted,#a0a79c)}.ds-progress progress{display:block;width:100%;height:4px;border:0;border-radius:2px;appearance:none;overflow:hidden;background:var(--line,#30382c);accent-color:var(--signal,#c4ff47)}.ds-progress progress::-webkit-progress-bar{background:var(--line,#30382c)}.ds-progress progress::-webkit-progress-value{background:var(--signal,#c4ff47)}.ds-progress progress::-moz-progress-bar{background:var(--signal,#c4ff47)}"
