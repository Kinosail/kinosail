  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The prominent action. The preview does not perform an operation.",
      "html": "<button class=\"ds-primary\">Resume</button>",
      "css": ".ds-primary{font-family:var(--font-ui,Manrope,sans-serif);font-size:1rem;font-weight:750;min-height:48px;padding:.7rem 1rem;border:0;border-radius:999px;background:var(--signal,#c4ff47);color:var(--signal-ink,#142000);transition:background-color 180ms var(--ease-out,cubic-bezier(.16,1,.3,1)),filter 180ms}.ds-primary:hover{filter:brightness(1.06)}.ds-primary:active{filter:brightness(1)}.ds-primary:focus-visible{outline:2px solid var(--focus,#daff98);outline-offset:4px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Quiet action",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Supporting action with the primary left visually dominant.",
      "html": "<button class=\"ds-quiet\">View details</button>",
      "css": ".ds-quiet{font-family:var(--font-ui,Manrope,sans-serif);font-size:.95rem;font-weight:700;min-height:44px;padding:.7rem 1rem;border:1px solid var(--line,#30382c);border-radius:12px;background:transparent;color:var(--text,#f6f8f2);transition:background-color 180ms var(--ease-out,cubic-bezier(.16,1,.3,1))}.ds-quiet:hover{background:var(--surface-2,#20271e)}.ds-quiet:focus-visible{outline:2px solid var(--focus,#daff98);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-quiet{transition:none}}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "input",
      "description": "Shared field, preserving an explicit label and visible keyboard focus.",
      "html": "<label class=\"ds-field\">Search<input type=\"search\" placeholder=\"Search\"></label>",
      "css": ".ds-field{display:grid;gap:.5rem;font-family:var(--font-ui,Manrope,sans-serif);color:var(--text,#f6f8f2)}.ds-field input{min-height:44px;padding:.68rem .85rem;border:1px solid var(--line,#30382c);border-radius:10px;background:var(--surface,#151914);color:var(--text,#f6f8f2);font:inherit;caret-color:var(--signal,#c4ff47)}.ds-field input::placeholder{color:var(--muted,#a0a79c)}.ds-field input:hover{border-color:var(--line-strong,#64705c)}.ds-field input:focus-visible{outline:2px solid var(--focus,#daff98);outline-offset:2px}"
    },
    {
      "name": "Selected destination",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Selected destination uses text and a bottom rule.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Preview destinations\"><a href=\"#\" aria-current=\"page\">Movies</a><a href=\"#\">TV Shows</a></nav>",
      "css": ".ds-nav{display:flex;gap:.5rem;font-family:var(--font-ui,Manrope,sans-serif)}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;padding:.6rem 1rem;border-bottom:2px solid transparent;color:var(--muted,#a0a79c);font-weight:600;text-decoration:none}.ds-nav a[aria-current]{color:var(--signal,#c4ff47);border-color:var(--signal,#c4ff47)}.ds-nav a:hover{color:var(--text,#f6f8f2);background:var(--surface,#151914)}.ds-nav a:focus-visible{outline:2px solid var(--focus,#daff98);outline-offset:4px}"
    },
    {
      "name": "Media artwork card",
      "kind": "card",
      "refersTo": "artwork-card",
      "description": "Media-kind placeholder demonstrates shape; production uses actual artwork.",
      "html": "<a class=\"ds-card\" href=\"#\"><span class=\"ds-art\" aria-hidden=\"true\"></span><strong>Media title</strong><small>Saved position</small></a>",
      "css": ".ds-card{display:grid;gap:.75rem;width:10rem;color:var(--text,#f6f8f2);text-decoration:none;font-family:var(--font-ui,Manrope,sans-serif)}.ds-art{display:block;aspect-ratio:2/3;border-radius:12px;background:var(--surface-2,#20271e)}.ds-card strong{font-size:1rem;line-height:1.4}.ds-card small{color:var(--muted,#a0a79c)}.ds-card:hover .ds-art,.ds-card:focus-visible .ds-art{outline:2px solid var(--text,#f6f8f2);outline-offset:3px}.ds-card:focus-visible{outline:2px solid var(--focus,#daff98);outline-offset:4px}"
    },
    {
      "name": "Open resume row",
      "kind": "custom",
      "refersTo": "resume-row",
      "description": "Content and saved position sit beside an untinted thumbnail.",
      "html": "<a class=\"ds-resume\" href=\"#\"><span class=\"ds-thumbnail\" aria-hidden=\"true\"></span><span><strong>Media title</strong><small>Resume at saved position</small></span><span class=\"ds-resume-action\">Resume</span></a>",
      "css": ".ds-resume{display:grid;grid-template-columns:7rem minmax(0,1fr) auto;align-items:center;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line,#30382c);color:var(--text,#f6f8f2);font-family:var(--font-ui,Manrope,sans-serif);text-decoration:none}.ds-thumbnail{aspect-ratio:16/9;border-radius:7px;background:var(--surface-2,#20271e)}.ds-resume small{display:block;color:var(--muted,#a0a79c);font-size:.8rem}.ds-resume-action{color:var(--signal,#c4ff47);font-size:.8rem}.ds-resume:hover{background:var(--surface,#151914)}.ds-resume:focus-visible{outline:2px solid var(--focus,#daff98);outline-offset:4px}"
