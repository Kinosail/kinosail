# Kinosail reads this file when the service starts. Restart after a change:
#   sudo systemctl restart kinosail
#
# Most people do not need this file. The setup wizard in your browser picks
# your movie folders and shares Kinosail with your TV and phone.
#
# Settings here override the wizard. For example, to fix the network address:
# KINOSAIL_LISTEN=0.0.0.0:38127
