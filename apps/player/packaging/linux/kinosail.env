# Kinosail reads this file when the service starts. Restart after a change:
#   sudo systemctl restart kinosail
#
# The folder that holds your movies and shows. The kinosail user must be able to read it.
# KINOSAIL_MEDIA_DIR=/srv/media
#
# Kinosail listens only on this computer until you create the Owner Profile.
# Then use this line to share it with other devices on your network:
# KINOSAIL_LISTEN=0.0.0.0:38127
