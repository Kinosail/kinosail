[Unit]
Description=Kinosail media server
Documentation=https://kinosail.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kinosail
Group=kinosail
EnvironmentFile=/usr/lib/kinosail/kinosail.defaults
EnvironmentFile=-/etc/kinosail/kinosail.env
ExecStart=/usr/lib/kinosail/kinosail
Restart=always
RestartSec=5
TimeoutStopSec=30
StateDirectory=kinosail
StateDirectoryMode=0750
CacheDirectory=kinosail
CacheDirectoryMode=0750
LogsDirectory=kinosail
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
