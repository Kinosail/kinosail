FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS build
WORKDIR /src
COPY packages/go.mod ./packages/go.mod
COPY apps/player/go.mod apps/player/go.sum ./apps/player/
RUN cd apps/player && go mod download
COPY packages ./packages
COPY apps/player/cmd ./apps/player/cmd
COPY apps/player/internal ./apps/player/internal
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN cd apps/player && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /kinosail ./cmd/kinosail

FROM docker.io/library/debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
ARG JELLYFIN_FFMPEG_VERSION=8.1.2-5
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates libaom3 libarchive-tools libchromaprint-tools mesa-va-drivers mesa-vulkan-drivers socat tzdata wget \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libaom3)" ge 3.12.1-1+deb13u1 \
    && arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
      amd64) checksum=30d9957e80051dd45740d4d4509941fdf2babf5a29c79bee109310b31dae0f6f; apt-get install -y --no-install-recommends i965-va-driver intel-media-va-driver ;; \
      arm64) checksum=f3af50c1fdd76197867b9cd812fe8a3a1c671829a3f626a0ddc58a8e48654740 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
    && wget -q -O /tmp/jellyfin-ffmpeg.deb "https://github.com/jellyfin/jellyfin-ffmpeg/releases/download/v${JELLYFIN_FFMPEG_VERSION}/jellyfin-ffmpeg8_${JELLYFIN_FFMPEG_VERSION}-trixie_${arch}.deb" \
    && echo "$checksum  /tmp/jellyfin-ffmpeg.deb" | sha256sum -c - \
    && apt-get install -y --no-install-recommends /tmp/jellyfin-ffmpeg.deb \
    && apt-get purge -y --auto-remove wget \
    && ln -s /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/local/bin/ffmpeg \
    && ln -s /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe \
    && groupadd -g 10001 kinosail \
    && useradd -M -u 10001 -g kinosail -s /usr/sbin/nologin kinosail \
	&& mkdir -p /config /cache /media /backups /public-transport \
	&& chown -R kinosail:kinosail /config /cache /backups /public-transport \
    && rm -f /tmp/jellyfin-ffmpeg.deb \
    && rm -rf /var/lib/apt/lists/*
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.version=$VERSION org.opencontainers.image.revision=$REVISION
COPY --from=build /kinosail /usr/local/bin/kinosail
COPY apps/player/LICENSE apps/player/LICENSING.md apps/player/THIRD_PARTY_NOTICES.md /licenses/
COPY apps/player/third_party /licenses/third_party
COPY apps/player/internal/server/static/third_party/jsqr/LICENSE /licenses/third_party/jsqr/LICENSE
COPY packages/webassets/static/fonts/OFL-Manrope.txt /licenses/third_party/Manrope.LICENSE
COPY packages/third_party /licenses/third_party
USER kinosail
ENV KINOSAIL_LISTEN=:38127
VOLUME ["/config", "/cache", "/backups"]
EXPOSE 38127
HEALTHCHECK CMD kinosail healthcheck
ENTRYPOINT ["kinosail"]
