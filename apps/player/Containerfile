FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY packages/go.mod ./packages/go.mod
COPY apps/player/go.mod apps/player/go.sum ./apps/player/
RUN cd apps/player && go mod download
COPY packages ./packages
COPY apps/player/cmd ./apps/player/cmd
COPY apps/player/internal ./apps/player/internal
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=cache,target=/root/.cache/go-build cd apps/player && GOCACHE=/root/.cache/go-build CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOAMD64=v1 GOARM64=v8.0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /kinosail ./cmd/kinosail

FROM docker.io/library/debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4
ARG JELLYFIN_FFMPEG_VERSION=8.1.3-1
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates libaom3 libarchive-tools libchromaprint-tools mesa-va-drivers mesa-vulkan-drivers socat tesseract-ocr tesseract-ocr-eng tesseract-ocr-spa tesseract-ocr-fra tesseract-ocr-deu tesseract-ocr-ita tesseract-ocr-por tesseract-ocr-nld tesseract-ocr-swe tesseract-ocr-dan tesseract-ocr-nor tesseract-ocr-fin tesseract-ocr-pol tesseract-ocr-ces tesseract-ocr-hun tesseract-ocr-tur tesseract-ocr-ron tesseract-ocr-rus tesseract-ocr-ukr tesseract-ocr-ell tzdata wget \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libaom3)" ge 3.12.1-1+deb13u1 \
    && for package in libssl3t64 openssl openssl-provider-legacy; do dpkg --compare-versions "$(dpkg-query -W -f='${Version}' "$package")" ge '3.5.7-1~deb13u3' || exit 1; done \
    && arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
      amd64) checksum=fbef9f81a53e175194e3f67832618a86111f7bd37197df21a5d748c34289f9c0; apt-get install -y --no-install-recommends i965-va-driver intel-media-va-driver ;; \
      arm64) checksum=4af743bd776eda082d40c851a4201e51a77a258145dd6ebe164dade39b35b2d0 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
    && wget -q -O /tmp/jellyfin-ffmpeg.deb "https://github.com/jellyfin/jellyfin-ffmpeg/releases/download/v${JELLYFIN_FFMPEG_VERSION}/jellyfin-ffmpeg8_${JELLYFIN_FFMPEG_VERSION}-trixie_${arch}.deb" \
    && echo "$checksum  /tmp/jellyfin-ffmpeg.deb" | sha256sum -c - \
    && apt-get install -y --no-install-recommends /tmp/jellyfin-ffmpeg.deb \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' librsvg2-2)" ge '2.60.0+dfsg-1+deb13u1' \
    && if brotli_version="$(dpkg-query -W -f='${Version}' libbrotli1 2>/dev/null)"; then dpkg --compare-versions "$brotli_version" ge '1.1.0-2+deb13u1'; fi \
    && if curl_version="$(dpkg-query -W -f='${Version}' libcurl4t64 2>/dev/null)"; then dpkg --compare-versions "$curl_version" ge '8.14.1-2+deb13u7'; fi \
    && if expat_version="$(dpkg-query -W -f='${Version}' libexpat1 2>/dev/null)"; then dpkg --compare-versions "$expat_version" ge '2.9.0-1~deb13u1'; fi \
    && apt-get purge -y --auto-remove wget \
    && ln -s /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/local/bin/ffmpeg \
    && ln -s /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe \
    && groupadd -g 10001 kinosail \
    && useradd -M -u 10001 -g kinosail -s /usr/sbin/nologin kinosail \
	&& mkdir -p /config /cache /media /backups /public-transport \
	&& chown -R kinosail:kinosail /config /cache /backups /public-transport \
    && rm -f /tmp/jellyfin-ffmpeg.deb \
    && rm -rf /var/lib/apt/lists/*
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.version=$VERSION org.opencontainers.image.revision=$REVISION
COPY --from=build /kinosail /usr/local/bin/kinosail
COPY apps/player/LICENSE apps/player/LICENSING.md apps/player/THIRD_PARTY_NOTICES.md /licenses/
COPY apps/player/third_party /licenses/third_party
COPY apps/player/internal/server/static/third_party/jsqr/LICENSE /licenses/third_party/jsqr/LICENSE
COPY packages/webassets/static/fonts/OFL-Manrope.txt /licenses/third_party/Manrope.LICENSE
COPY packages/third_party /licenses/third_party
USER kinosail
ENV KINOSAIL_LISTEN=:38127
VOLUME ["/config", "/cache", "/backups"]
EXPOSE 38127
HEALTHCHECK CMD kinosail healthcheck
ENTRYPOINT ["kinosail"]
