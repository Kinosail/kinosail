{
  "openapi": "3.1.0",
  "info": {"title": "Kinosail Server API", "version": "1.0.0", "description": "Versioned direct-media API."},
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}],
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "parameters": {
      "Id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
      "Name": {"name": "name", "in": "path", "required": true, "schema": {"type": "string"}},
      "Task": {"name": "task", "in": "path", "required": true, "schema": {"type": "string", "enum": ["scan", "metadata", "clear-cache", "maintain"]}}
    },
    "responses": {"Result": {"description": "Successful response; the operation schema is versioned with the endpoint."}}
  },
  "paths": {
    "/api/v1/management-access": {"get": {"summary": "Read private management status", "operationId": "getManagementAccess", "description": "Private Owner access only. Returns enabled state, HTTPS address, UDP endpoint and paired-device labels and public keys. Private keys and preshared keys are never returned.", "responses": {"200": {"description": "Private management status"}, "400": {"description": "Invalid request or unavailable management state"}, "401": {"description": "Sign-in required"}, "403": {"description": "Owner session or fresh two-step sign-in required"}, "404": {"description": "Unavailable through public access"}}}, "post": {"summary": "Enable private management", "operationId": "enableManagementAccess", "description": "Private Owner access only. Changes require two-step sign-in within the last ten minutes. Enabling and pairing require the home network. API keys cannot change private management. Unknown or duplicate fields and query parameters are rejected.", "responses": {"200": {"description": "Private management status"}, "400": {"description": "Invalid request or unavailable management state"}, "401": {"description": "Sign-in required"}, "403": {"description": "Owner session or fresh two-step sign-in required"}, "404": {"description": "Unavailable through public access"}}, "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["endpoint"], "properties": {"endpoint": {"type": "string", "minLength": 1, "maxLength": 259, "description": "Lowercase public DNS hostname and canonical UDP port from 1024 through 65535, for example family.duckdns.org:51821."}}}}}}}, "delete": {"summary": "Disable private management and erase all pairings", "operationId": "disableManagementAccess", "description": "Private Owner access only. Changes require two-step sign-in within the last ten minutes. Enabling and pairing require the home network. API keys cannot change private management. Unknown or duplicate fields and query parameters are rejected.", "responses": {"200": {"description": "Private management status"}, "400": {"description": "Invalid request or unavailable management state"}, "401": {"description": "Sign-in required"}, "403": {"description": "Owner session or fresh two-step sign-in required"}, "404": {"description": "Unavailable through public access"}}, "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": [], "properties": {}}}}}}},
    "/api/v1/management-access/devices": {"post": {"summary": "Pair one device to the signed-in Owner", "operationId": "pairManagementDevice", "description": "Private Owner access only. Changes require two-step sign-in within the last ten minutes. Enabling and pairing require the home network. API keys cannot change private management. Unknown or duplicate fields and query parameters are rejected.", "responses": {"201": {"description": "Device profile (private; shown once)"}, "400": {"description": "Invalid request or unavailable management state"}, "401": {"description": "Sign-in required"}, "403": {"description": "Owner session or fresh two-step sign-in required"}, "404": {"description": "Unavailable through public access"}}, "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["label"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 80, "description": "Human-readable device name, at most 80 characters; no control characters."}}}}}}}, "delete": {"summary": "Revoke a management device and close its connections", "operationId": "revokeManagementDevice", "description": "Private Owner access only. Changes require two-step sign-in within the last ten minutes. Enabling and pairing require the home network. API keys cannot change private management. Unknown or duplicate fields and query parameters are rejected.", "responses": {"200": {"description": "Private management status"}, "400": {"description": "Invalid request or unavailable management state"}, "401": {"description": "Sign-in required"}, "403": {"description": "Owner session or fresh two-step sign-in required"}, "404": {"description": "Unavailable through public access"}}, "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["publicKey"], "properties": {"publicKey": {"type": "string", "minLength": 44, "maxLength": 44, "description": "Canonical base64 WireGuard public key from management status."}}}}}}}},
    "/api/v1/items/{id}/cast": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"summary": "Create a local-network media capability for Google Cast or a discovered DLNA receiver. DLNA requires deviceId; Google Cast forbids it.", "responses": {"201": {"$ref": "#/components/responses/Result"}}, "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["protocol"], "properties": {"protocol": {"type": "string", "enum": ["google-cast", "dlna"]}, "deviceId": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "position": {"type": "number", "minimum": 0, "maximum": 31536000}, "playbackToken": {"type": "string", "maxLength": 8192}}}}}}}},
    "/api/v1/cast/devices/scan": {"post": {"summary": "Discover bounded DLNA receivers on the Server network.", "responses": {"200": {"$ref": "#/components/responses/Result"}}, "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}}}}}},
    "/api/v1/cast/config": {"get": {"summary": "Read the local sender's configured Google Cast receiver app ID; empty uses the default video receiver.", "responses": {"200": {"description": "Cast receiver configuration", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["appId"], "properties": {"appId": {"type": "string", "pattern": "^([A-Fa-f0-9]{8})?$"}}}}}}}}},
    "/api/v1/cast/sessions/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "get": {"summary": "Read playback state of the owned DLNA session.", "responses": {"200": {"$ref": "#/components/responses/Result"}}}, "delete": {"summary": "Revoke an owned TV media capability.", "responses": {"204": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/cast/sessions/{id}/commands": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"summary": "Control an owned DLNA session. Only seek requires and accepts position.", "responses": {"204": {"$ref": "#/components/responses/Result"}}, "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"type": "string", "enum": ["play", "pause", "stop", "seek"]}, "position": {"type": "number", "minimum": 0, "maximum": 31536000}}}}}}}},
    "/api/v1/me/media-preferences": {"get": {"operationId": "getMediaPreferences", "responses": {"default": {"$ref": "#/components/responses/Result"}}}, "put": {"operationId": "saveMediaPreferences", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/items/{id}/playback-preferences": {"parameters": [{"$ref": "#/components/parameters/Id"}], "get": {"operationId": "getPlaybackPreferences", "responses": {"default": {"$ref": "#/components/responses/Result"}}}, "put": {"operationId": "savePlaybackPreferences", "responses": {"default": {"$ref": "#/components/responses/Result"}}}, "delete": {"operationId": "resetPlaybackPreferences", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/items/{id}/bookmarks": {"parameters": [{"$ref": "#/components/parameters/Id"}], "get": {"operationId": "getMediaBookmarks", "responses": {"default": {"$ref": "#/components/responses/Result"}}}, "post": {"operationId": "addMediaBookmark", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/items/{id}/bookmarks/{bookmark}": {"parameters": [{"$ref": "#/components/parameters/Id"}, {"name": "bookmark", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}], "delete": {"operationId": "removeMediaBookmark", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/items/{id}/progress/sync": {"parameters": [{"$ref": "#/components/parameters/Id"}], "put": {"operationId": "synchronizeMediaProgress", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/actor": {"get": {"operationId": "getActorLibrary", "summary": "Movies and shows with an actor in the visible library", "parameters": [{"name": "name", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 200}}], "responses": {"200": {"description": "Actor name, photo, movies, and deduplicated shows with roles and public links"}, "400": {"description": "Invalid actor query"}}}},
    "/api/v1": {"get": {"operationId": "getAPIRoot", "security": [], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/openapi.json": {"get": {"operationId": "getOpenAPI", "security": [], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/setup": {"post": {"operationId": "setupServer", "security": [], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/session": {"post": {"operationId": "createSession", "security": [], "responses": {"default": {"$ref": "#/components/responses/Result"}}}, "delete": {"operationId": "deleteSession", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/session/oidc": {"get": {"operationId": "startOIDCSession", "security": [], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/session/saml": {"get": {"operationId": "startSAMLSession", "security": [], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/passkeys/register/begin": {"post": {"operationId": "beginPasskeyRegistration", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/passkeys/register/finish": {"post": {"operationId": "finishPasskeyRegistration", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/passkeys": {"get": {"operationId": "listPasskeys", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/passkeys/{id}": {"parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}], "delete": {"operationId": "deletePasskey", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/passkeys/login/begin": {"post": {"operationId": "beginPasskeyLogin", "security": [], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/passkeys/login/finish": {"post": {"operationId": "finishPasskeyLogin", "security": [], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/me": {"get": {"operationId": "getCurrentViewer", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/me/mfa/setup": {"post": {"operationId": "beginMFAEnrollment", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/me/mfa": {"put": {"operationId": "enableMFA", "responses": {"default": {"$ref": "#/components/responses/Result"}}}, "delete": {"operationId": "disableMFA", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/me/oidc/link": {"get": {"operationId": "linkOIDC", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/me/oidc": {"delete": {"operationId": "unlinkOIDC", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/me/saml/link": {"get": {"operationId": "linkSAML", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/me/saml": {"delete": {"operationId": "unlinkSAML", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/me/language": {"put": {"operationId": "saveLanguage", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["language"], "properties": {"language": {"type": "string", "enum": ["auto","en","es","de","fr","pt-BR","zh-Hans","it","nl","pl","ru","ja","ko","ar","tr","uk","pt-PT","zh-Hant","sv","ab","af","as","az","be-BY","bg-BG","bn","bn-BD","br","bs","ca","ch","ckb","cs","cy","da","dv","el","en-GB","en-US","eo","es-AR","es-MX","es-419","es-DO","et","eu","fa","fi","fil","fo","fr-CA","ga","gl","gsw","gu","he","he-IL","hi-IN","hr","ht","hu","hy","id","is-IS","jbo","ka","kab","kk","kn","kw","ky","lb","lt-LT","lv","mg","mi","mk","ml","mn","mr","ms","mt","my","nb","nds","ne","nn","oc","pa","pt","ro","si","sk","sl-SI","so","sq","sr","sw","ta","te","th","ug","ur-PK","uz","vi","zh-CN","zh-HK","zh-TW","zu"]}}}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/quick-connect": {"post": {"operationId": "startQuickConnect", "security": [], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/quick-connect/token": {"post": {"operationId": "pollQuickConnect", "security": [], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/quick-connect/{code}": {"parameters": [{"name": "code", "in": "path", "required": true, "schema": {"type": "string"}}], "post": {"operationId": "approveQuickConnect", "responses": {"default": {"$ref": "#/components/responses/Result"}}}, "get": {"operationId": "previewQuickConnect", "summary": "Read a six-digit, unapproved local device request. Requires a signed-in session; API keys and public-listener access are denied. Never returns polling secrets.", "responses": {"200": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/quick-connect/pending": {"get": {"operationId": "pendingQuickConnectTVs", "summary": "List at most eight unapproved local native TV requests. Session-only, rate-limited, and never cached. Each record contains code, device, and expiresAt.", "responses": {"200": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/quick-connect/cancel": {"post": {"operationId": "cancelQuickConnect", "security": [], "summary": "Withdraw a request using its device-held polling secret. Idempotent after cancellation or consumption.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["secret"], "properties": {"secret": {"type": "string", "minLength": 1, "maxLength": 128}}}}}}, "responses": {"204": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/home-assistant": {"get": {"operationId": "getHomeAssistantIntegration", "security": [], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/home-assistant/pair": {"post": {"operationId": "pairHomeAssistant", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["code", "name"], "properties": {"code": {"type": "string", "pattern": "^[0-9]{8}$"}, "name": {"type": "string", "minLength": 1, "maxLength": 80}}}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/home-assistant/token": {"post": {"operationId": "exchangeHomeAssistantAuthorizationCode", "security": [], "requestBody": {"required": true, "content": {"application/x-www-form-urlencoded": {"schema": {"type": "object", "additionalProperties": false, "required": ["grant_type", "client_id", "code", "redirect_uri", "code_verifier"], "properties": {"grant_type": {"const": "authorization_code"}, "client_id": {"const": "home-assistant"}, "code": {"type": "string", "maxLength": 128}, "redirect_uri": {"type": "string", "format": "uri", "maxLength": 2048}, "code_verifier": {"type": "string", "minLength": 43, "maxLength": 128}}}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/home-assistant/pairings": {"post": {"operationId": "createHomeAssistantPairing", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/home-assistant/library": {"get": {"operationId": "listHomeAssistantLibrary", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/home-assistant/playback/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "resolveHomeAssistantPlayback", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/home-assistant/players": {"get": {"operationId": "listHomeAssistantPlayers", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/home-assistant/players/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "put": {"operationId": "updateHomeAssistantPlayer", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/home-assistant/players/{id}/commands": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "commandHomeAssistantPlayer", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/remote-players": {"get": {"operationId": "listRemotePlayers", "summary": "List recently active players for the current Viewer Profile.", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/remote-players/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "put": {"operationId": "updateRemotePlayer", "summary": "Publish one player's state and consume its next queued command.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["name", "state"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 80}, "title": {"type": "string", "maxLength": 256}, "artist": {"type": "string", "maxLength": 128}, "itemId": {"type": "string", "maxLength": 128}, "state": {"type": "string", "enum": ["idle", "playing", "paused", "buffering"]}, "position": {"type": "number", "minimum": 0, "maximum": 1000000000}, "duration": {"type": "number", "minimum": 0, "maximum": 1000000000}, "audio": {"type": "boolean"}}}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/remote-players/{id}/commands": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "commandRemotePlayer", "summary": "Queue a bounded playback command for an active player in the current Viewer Profile. Seek alone accepts position.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["command", "itemId"], "properties": {"command": {"type": "string", "enum": ["play", "pause", "backward", "forward", "previous", "next", "seek"]}, "itemId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}, "position": {"type": "number", "minimum": 0, "maximum": 1000000000}}}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/events": {"get": {"operationId": "streamEvents", "description": "Streams profile-scoped invalidation events. Resume with Last-Event-ID.", "parameters": [{"name": "Last-Event-ID", "in": "header", "schema": {"type": "string", "pattern": "^[0-9]{1,20}$"}}], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/library": {"get": {"operationId": "listLibrary", "parameters": [{"name": "q", "in": "query", "schema": {"type": "string", "maxLength": 512}}, {"name": "view", "in": "query", "schema": {"type": "string", "enum": ["all", "list", "unwatched", "history", "movies", "shows", "collections", "playlists", "music", "audiobooks", "books", "photos"]}}, {"name": "sort", "in": "query", "schema": {"type": "string", "enum": ["title", "added", "year"]}}, {"name": "letter", "in": "query", "description": "Jump to an available title bucket. Valid only with title sort and without q or offset; available labels and counts are returned in letters.", "schema": {"type": "string", "maxLength": 1}}, {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0, "maximum": 1000000, "default": 0}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 100}}], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/shows": {"get": {"operationId": "listShows", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/shows/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "get": {"operationId": "getShow", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/albums": {"get": {"operationId": "listAlbums", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/albums/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "get": {"operationId": "getAlbum", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/items/{id}": {"parameters": [{"$ref": "#/components/parameters/Id"}], "get": {"operationId": "getItem", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/items/{id}/watch-progress": {"parameters": [{"$ref": "#/components/parameters/Id"}], "get": {"operationId": "getWatchProgress", "responses": {"200": {"description": "Viewer position and original runtime in seconds; zero duration means unknown", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["seconds", "duration"], "properties": {"seconds": {"type": "number", "minimum": 0, "maximum": 315360000}, "duration": {"type": "number", "minimum": 0, "maximum": 315360000}}}}}}, "default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/items/{id}/playback": {"parameters": [{"$ref": "#/components/parameters/Id"}], "get": {"operationId": "getPlayback", "parameters": [{"name": "videoCodecs", "in": "query", "style": "form", "explode": false, "schema": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "enum": ["h264", "hevc", "av1", "vp9"]}}}, {"name": "audioCodecs", "in": "query", "style": "form", "explode": false, "schema": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "enum": ["aac", "mp3", "opus", "vorbis", "ac3", "eac3"]}}}, {"name": "hdrFormats", "in": "query", "description": "Current display HDR modes; include sdr. Does not grant conversion permission.", "style": "form", "explode": false, "schema": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["sdr", "hdr10", "hlg"]}}}, {"name": "maxAudioChannels", "in": "query", "description": "Decoded audio channels for the current playback route; not encoded passthrough.", "schema": {"type": "integer", "minimum": 1, "maximum": 8}}], "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/items/{id}/playback-events": {"parameters": [{"$ref": "#/components/parameters/Id"}], "post": {"operationId": "recordPlaybackEvent", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["session", "event", "sequence"], "properties": {"session": {"type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"}, "event": {"type": "string"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 1000000}}}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/items/{id}/markers": {"parameters": [{"$ref": "#/components/parameters/Id"}], "put": {"operationId": "savePlaybackMarker", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/items/{id}/markers/{type}": {"parameters": [{"$ref": "#/components/parameters/Id"}, {"name": "type", "in": "path", "required": true, "schema": {"type": "string", "enum": ["intro", "recap", "commercial", "outro", "credits"]}}], "delete": {"operationId": "deletePlaybackMarker", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/marker-analysis": {"get": {"operationId": "getPlaybackMarkerAnalysis", "responses": {"default": {"$ref": "#/components/responses/Result"}}}, "post": {"operationId": "runPlaybackMarkerAnalysis", "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
    "/api/v1/media-shares": {"get": {"operationId": "listMediaShares", "responses": {"default": {"$ref": "#/components/responses/Result"}}}, "post": {"operationId": "createMediaShare", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["itemIds", "expiresInSeconds", "maxDevices", "rightsAcknowledged"], "properties": {"itemIds": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "expiresInSeconds": {"type": "integer", "minimum": 60, "maximum": 86400}, "maxDevices": {"type": "integer", "minimum": 1, "maximum": 8}, "rightsAcknowledged": {"type": "boolean", "const": true}}}}}}, "responses": {"default": {"$ref": "#/components/responses/Result"}}}},
