FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS build
WORKDIR /src
COPY packages/go.mod ./packages/go.mod
COPY apps/dashboard/go.mod apps/dashboard/go.sum ./apps/dashboard/
RUN cd apps/dashboard && go mod download
COPY packages ./packages
COPY apps/dashboard/cmd ./apps/dashboard/cmd
COPY apps/dashboard/internal ./apps/dashboard/internal
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN mkdir /config \
    && chown 10001:10001 /config \
    && cd apps/dashboard \
    && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /kinosail-dashboard ./cmd/kinosail-dashboard

FROM scratch
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="Kinosail Dashboard" \
      org.opencontainers.image.version=$VERSION \
      org.opencontainers.image.revision=$REVISION \
      org.opencontainers.image.licenses="PolyForm-Perimeter-1.0.1"
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /kinosail-dashboard /kinosail-dashboard
COPY --from=build --chown=10001:10001 /config /config
COPY apps/dashboard/LICENSE apps/dashboard/LICENSING.md /licenses/
COPY packages/third_party/go-yaml /licenses/third_party/go-yaml
USER 10001:10001
ENV KINOSAIL_DASHBOARD_LISTEN=:38400 \
    KINOSAIL_DASHBOARD_DATA_DIR=/config
VOLUME ["/config"]
EXPOSE 38400
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/kinosail-dashboard", "healthcheck"]
ENTRYPOINT ["/kinosail-dashboard"]
