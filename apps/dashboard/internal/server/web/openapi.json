{
  "openapi": "3.1.0",
  "info": {"title": "Kinosail Dashboard API", "version": "1.0.0", "description": "The API used by the web application. Mutations require an exact expectedVersion. Cookie requests also require X-Kinosail-CSRF."},
  "servers": [{"url": "/"}],
  "security": [{"cookieAuth": []}, {"bearerAuth": []}],
  "paths": {
    "/api/v1": {"get": {"summary": "Describe the API", "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/openapi.json": {"get": {"summary": "Read this OpenAPI document", "responses": {"200": {"description": "OpenAPI document", "content": {"application/json": {"schema": {"type": "object"}}}}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/setup": {"post": {"summary": "Create the first Owner", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Credentials"}}}}, "responses": {"201": {"$ref": "#/components/responses/Session"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/session": {
      "post": {"summary": "Create an Owner session", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Credentials"}}}}, "responses": {"201": {"$ref": "#/components/responses/Session"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}},
      "delete": {"summary": "End the presented session", "responses": {"204": {"description": "Session ended"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/owner/password": {"post": {"summary": "Change the Owner password and revoke other sessions", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PasswordChange"}}}}, "responses": {"204": {"description": "Password changed"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "500": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/passkeys/register/begin": {"post": {"summary": "Begin Owner passkey registration", "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "421": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/passkeys/register/finish": {"post": {"summary": "Finish Owner passkey registration", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"204": {"description": "Passkey registered"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "421": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/passkeys/login/begin": {"post": {"summary": "Begin discoverable passkey sign-in", "security": [], "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "421": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/passkeys/login/finish": {"post": {"summary": "Finish discoverable passkey sign-in", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"204": {"description": "Session created"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "421": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/me": {"get": {"summary": "Read the current Owner and CSRF token", "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/catalog": {"get": {"summary": "List built-in application defaults", "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/board": {
      "get": {"summary": "Read the shared board", "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "401": {"$ref": "#/components/responses/Error"}}},
      "put": {"summary": "Rename the shared board", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BoardRename"}}}}, "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/apps": {"post": {"summary": "Add an application", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateApp"}}}}, "responses": {"201": {"$ref": "#/components/responses/JSONSuccess"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/apps/{id}": {
      "parameters": [{"$ref": "#/components/parameters/AppID"}],
      "patch": {"summary": "Update an application", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateApp"}}}}, "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}},
      "delete": {"summary": "Remove an application with recovery", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExpectedVersion"}}}}, "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/apps/{id}/restore": {"parameters": [{"$ref": "#/components/parameters/AppID"}], "post": {"summary": "Restore a recently removed application", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExpectedVersion"}}}}, "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/apps/order": {"put": {"summary": "Set the canonical application order", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AppOrder"}}}}, "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/apps/{id}/check": {"parameters": [{"$ref": "#/components/parameters/AppID"}], "post": {"summary": "Check one application from the Server", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmptyObject"}}}}, "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/board/check": {"post": {"summary": "Check every enabled application", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmptyObject"}}}}, "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/export": {"get": {"summary": "Export application configuration", "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/import": {"put": {"summary": "Import a validated board backup", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BoardImport"}}}}, "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/import/preview": {"post": {"summary": "Preview a Homarr, Homepage, or Dashy config", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExternalImport"}}}}, "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/import/external": {"post": {"summary": "Import a previewed external dashboard config", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExternalImportCommit"}}}}, "responses": {"200": {"$ref": "#/components/responses/JSONSuccess"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/supporter": {"get": {"summary": "Read signed local Supporter recognition", "responses": {"200": {"description": "Supporter status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SupporterStatus"}}}}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/supporter/activate": {"post": {"summary": "Verify and save optional Supporter recognition", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SupporterActivation"}}}}, "responses": {"200": {"description": "Verified recognition", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SupporterStatus"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "502": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/mcp-token": {
      "post": {"summary": "Replace and return the one full-owner MCP token", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmptyObject"}}}}, "responses": {"201": {"$ref": "#/components/responses/JSONSuccess"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}},
      "delete": {"summary": "Revoke MCP access", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmptyObject"}}}}, "responses": {"204": {"description": "MCP token revoked"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}}
    }
  },
  "components": {
    "securitySchemes": {"cookieAuth": {"type": "apiKey", "in": "cookie", "name": "kinosail_dashboard_session"}, "bearerAuth": {"type": "http", "scheme": "bearer"}},
    "parameters": {"AppID": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-z0-9-]{24}$"}}},
    "responses": {
      "JSONSuccess": {"description": "Successful response", "content": {"application/json": {"schema": {"type": "object"}}}},
      "Session": {"description": "Session created", "headers": {"Set-Cookie": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"type": "object", "required": ["owner", "csrf", "expiresAt"]}}}},
      "Error": {"description": "Request failed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    },
    "schemas": {
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}},
      "EmptyObject": {"type": "object", "additionalProperties": false},
      "Credentials": {"type": "object", "additionalProperties": false, "required": ["name", "password", "device"], "properties": {"name": {"type": "string", "maxLength": 60}, "password": {"type": "string", "format": "password", "description": "12 to 72 UTF-8 bytes without surrounding spaces"}, "device": {"type": "string", "maxLength": 80}}},
      "PasswordChange": {"type": "object", "additionalProperties": false, "required": ["currentPassword", "newPassword", "confirmPassword"], "properties": {"currentPassword": {"type": "string", "format": "password", "description": "1 to 72 UTF-8 bytes"}, "newPassword": {"type": "string", "format": "password", "description": "12 to 72 UTF-8 bytes without surrounding spaces"}, "confirmPassword": {"type": "string", "format": "password", "description": "Must exactly match newPassword"}}},
      "ExpectedVersion": {"type": "object", "additionalProperties": false, "required": ["expectedVersion"], "properties": {"expectedVersion": {"type": "integer", "minimum": 1}}},
      "BoardRename": {"type": "object", "additionalProperties": false, "required": ["title", "expectedVersion"], "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 60}, "expectedVersion": {"type": "integer", "minimum": 1}}},
      "CreateApp": {"type": "object", "additionalProperties": false, "required": ["url", "expectedVersion"], "properties": {"catalogId": {"type": "string"}, "name": {"type": "string", "maxLength": 60}, "url": {"type": "string", "format": "uri", "maxLength": 2048}, "healthUrl": {"type": "string", "format": "uri", "maxLength": 2048}, "checkEnabled": {"type": "boolean"}, "description": {"type": "string", "maxLength": 120}, "category": {"type": "string", "maxLength": 40}, "icon": {"type": "string"}, "accent": {"type": "string", "enum": ["lime", "ocean", "amber", "coral", "sky", "violet", "slate"]}, "favorite": {"type": "boolean"}, "expectedVersion": {"type": "integer", "minimum": 1}}},
      "UpdateApp": {"type": "object", "additionalProperties": false, "required": ["expectedVersion"], "properties": {"name": {"type": "string", "maxLength": 60}, "url": {"type": "string", "format": "uri", "maxLength": 2048}, "healthUrl": {"type": "string", "format": "uri", "maxLength": 2048}, "checkEnabled": {"type": "boolean"}, "description": {"type": "string", "maxLength": 120}, "category": {"type": "string", "maxLength": 40}, "icon": {"type": "string"}, "accent": {"type": "string"}, "favorite": {"type": "boolean"}, "expectedVersion": {"type": "integer", "minimum": 1}}},
      "AppOrder": {"type": "object", "additionalProperties": false, "required": ["ids", "expectedVersion"], "properties": {"ids": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string"}}, "expectedVersion": {"type": "integer", "minimum": 1}}},
      "BoardImport": {"type": "object", "additionalProperties": false, "required": ["title", "apps", "expectedVersion"], "properties": {"title": {"type": "string", "maxLength": 60}, "apps": {"type": "array", "maxItems": 200, "items": {"type": "object"}}, "expectedVersion": {"type": "integer", "minimum": 1}}},
      "ExternalImport": {"type": "object", "additionalProperties": false, "required": ["source", "content"], "properties": {"source": {"type": "string", "enum": ["homarr", "homepage", "dashy"]}, "content": {"type": "string", "maxLength": 2097152}}},
      "ExternalImportCommit": {"type": "object", "additionalProperties": false, "required": ["source", "content", "expectedVersion"], "properties": {"source": {"type": "string", "enum": ["homarr", "homepage", "dashy"]}, "content": {"type": "string", "maxLength": 2097152}, "expectedVersion": {"type": "integer", "minimum": 1}}},
      "SupporterActivation": {"type": "object", "additionalProperties": false, "required": ["key"], "properties": {"key": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"}, "recognitionName": {"type": "string", "minLength": 1, "maxLength": 80}}},
      "SupporterStatus": {"type": "object", "additionalProperties": false, "required": ["appId", "tier", "name", "rank", "active", "expired", "sustaining", "founding", "patronOrder", "livingStandard", "badgeCase", "activationAvailable", "supportUrl"], "properties": {"appId": {"const": "kino-dashboard"}, "tier": {"type": "string"}, "name": {"type": "string"}, "rank": {"type": "integer", "minimum": 0, "maximum": 10}, "active": {"type": "boolean"}, "expired": {"type": "boolean"}, "sustaining": {"type": "boolean"}, "founding": {"type": "boolean"}, "patronOrder": {"type": ["object", "null"]}, "livingStandard": {"type": ["object", "null"]}, "badgeCase": {"type": "object", "required": ["livingLevel", "patronLevel", "masterworkLevel", "unlocked", "total", "masterworkName", "masterworkEarned", "masterworkActive"]}, "activationAvailable": {"type": "boolean"}, "supportUrl": {"type": "string"}}}
    }
  }
}
