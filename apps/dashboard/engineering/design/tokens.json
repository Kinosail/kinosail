{
  "product": "Kinosail Dashboard",
  "visualDirection": "Household Network Console",
  "palette": {
    "background": "#090a08",
    "surface": "#11130f",
    "surfaceMuted": "#191c16",
    "textPrimary": "#f6f8ef",
    "textSecondary": "#9ca391",
    "border": "#2d3327",
    "accentPrimary": "#c8f169",
    "accentSecondary": "#e4ff9c",
    "success": "#80d89a",
    "warning": "#f0c36a",
    "danger": "#ff7772",
    "info": "#91bde8"
  },
  "typography": {
    "uiFont": "ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "displayFont": "ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "monoFont": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "scale": {"xs":"12px","sm":"13px","base":"15px","lg":"17px","xl":"21px","2xl":"30px","display":"38px"},
    "rules": ["Use tabular numbers for latency", "Use monospace only for addresses and measurements"]
  },
  "spacing": {"density":"balanced","scale":[4,8,12,16,20,24,32,40,48],"sectionSpacing":"32px","cardPadding":"16px"},
  "radius": {"small":"8px","medium":"12px","large":"18px","rules":["Tiles use 14px", "Pills only express compact state"]},
  "elevation": {"surface":"none","popover":"0 16px 48px rgba(0,0,0,.38)","modal":"0 24px 72px rgba(0,0,0,.48)","rules":["Only floating layers use shadows"]},
  "icons": {"set":"local embedded SVG and monograms","style":"two-tone geometric","emojiAllowed":false,"rules":["Never fetch remote icons"]},
  "motion": {"principle":"functional only","durationFast":"140ms","durationNormal":"200ms","easing":"cubic-bezier(.2,.8,.2,1)","allowedUses":["dialog open","drag placement","save state"],"forbiddenUses":["idle animation","background animation","decorative hover movement"]},
  "antiSlopConstraints": ["No metric card strip", "No purple gradients", "No nested cards", "No fake activity", "No universal pills"]
}
